{
  "expo": {
    "name": "Hubera Fuel",
    "slug": "gasoil-tracking",
    "version": "1.4.166",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gasoiltracking",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.hubera.fuel",
      "deploymentTarget": "15.1",
      "associatedDomains": [
        "applinks:fuel.hubera.cloud",
        "applinks:maps.hubera.cloud"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Hubera Fuel",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Hubera Fuel utilise votre position pour suivre vos trajets et calculer la consommation en temps réel.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Hubera Fuel suit vos trajets en arrière-plan pendant la navigation pour estimer la consommation de carburant.",
        "NSLocationAlwaysUsageDescription": "Hubera Fuel suit vos trajets en arrière-plan pendant la navigation pour estimer la consommation de carburant.",
        "NSContactsUsageDescription": "Hubera Fuel propose les adresses de vos contacts comme destinations de trajet.",
        "NSCameraUsageDescription": "Hubera Fuel utilise la caméra pour scanner le QR de connexion et photographier le CT ou la carte grise.",
        "NSPhotoLibraryUsageDescription": "Hubera Fuel peut joindre une photo du CT ou de la carte grise.",
        "LSApplicationQueriesSchemes": [
          "hubera-maps",
          "cloudity-maps"
        ],
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ]
      },
      "config": {
        "googleMapsApiKey": "VOTRE_CLE_GOOGLE_MAPS_IOS"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF0033"
      },
      "package": "cloud.hubera.fuel",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "READ_CONTACTS",
        "CAMERA"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "VOTRE_CLE_GOOGLE_MAPS_ANDROID"
        }
      },
      "versionCode": 190,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "fuel.hubera.cloud",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "fuel.hubera.cloud",
              "pathPrefix": "/qr-login"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Hubera Fuel suit vos trajets en arrière-plan pour calculer la consommation.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#e94560",
          "sounds": []
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Hubera Fuel propose les adresses de vos contacts comme destinations."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hubera Fuel utilise la caméra pour scanner le QR de connexion du site web.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Hubera Fuel utilise la caméra pour photographier le CT ou la carte grise."
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "./plugins/withHuberaMapsQueries.js",
      "./plugins/withReleaseSigning.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://fuel.hubera.cloud",
      "personalMail": "paveldelhomme@gmail.com",
      "enableGpsSimulator": false,
      "eas": {
        "projectId": "d85bab84-0971-4266-8f8c-a37113bc7761"
      },
      "whatsNew": "Session Fuel qui reste connectée, sync du compte à la connexion, plein Maps poussé dans le cloud. MAJ jamais bloquante.",
      "router": {
        "origin": false
      }
    },
    "owner": "pavel_delhomme"
  }
}
