# =============================================================================
# Gasoil Tracking — modèle .env (copier vers .env, ne jamais committer .env)
# Garder les blocs « comptes » ensemble : ADMIN_* / PERSONAL_* / QA_LAB_* côte à côte.
# =============================================================================

# --- App / domaine ---
GASOIL_DOMAIN=gasoil-tracking.delhomme.ovh
GASOIL_HOST_PORT=3340
APP_VERSION=1.4.56
PUBLIC_URL=https://gasoil-tracking.delhomme.ovh

# --- Comptes applicatifs (à garder ensemble) ---
# Admin (bootstrap API / écran Administration)
ADMIN_EMAIL=admin@delhomme.ovh
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_RESET_PASSWORD=0

# Compte perso (manager + login app)
PERSONAL_MAIL=paveldelhomme@gmail.com
PERSONAL_PASSWORD=
EXPO_PUBLIC_PERSONAL_MAIL=paveldelhomme@gmail.com

# Compte QA labo (données jetables)
# Gérer avec : ./scripts/qa-lab-account.sh status|create|reset|delete
QA_LAB_EMAIL=qa.lab@maily.ovh
QA_LAB_PASSWORD=
QA_LAB_NAME=QA Lab Gasoil

# --- Auth / sécurité API ---
JWT_SECRET=
INVITE_CODE=
RELEASE_UPLOAD_TOKEN=

# --- Hubera ID (SSO cross-app) ---
EXPO_PUBLIC_HUBERA_ID_URL=https://id.hubera.cloud
HUBERA_SSO_ENABLED=1

# --- SMTP (OVH) — port 587 = STARTTLS → SMTP_SECURE=false et SMTP_USE_SSL=false ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gasoil Tracking <noreply@maily.ovh>"
SMTP_SECURE=false
SMTP_USE_SSL=false

# --- Portainer ---
PORTAINER_URL=https://portainer.delhomme.ovh
PORTAINER_USERNAME=
PORTAINER_PASSWORD=
PORTAINER_ACCESS_TOKEN=
# PORTAINER_WEBHOOK_URL=

# --- Nginx Proxy Manager ---
NPM_URL=https://nginx.delhomme.ovh
NPM_EMAIL=
NPM_PASSWORD=

# --- Expo / EAS (CI) ---
EXPO_TOKEN=
